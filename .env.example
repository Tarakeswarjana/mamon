# Copy this file to `.env.local` and fill in your values.
# Never commit real SMTP credentials.

# SMTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-character-app-password

# Where food requests and other care alerts should arrive
NOTIFICATION_EMAIL=tarakeswarjana0808@gmail.com

# Optional. Defaults to SMTP_USER.
# SMTP_FROM=your.email@gmail.com

# Shown in the greeting and letter. Safe to expose to the browser.
NEXT_PUBLIC_GIRLFRIEND_NAME=Mamon

# Optional. Use Upstash Redis in production so rate limits persist across
# Vercel serverless instances. The app works without these.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
