# Copy this file to `.env.local` and fill in your values.
# Never commit real SMTP credentials.

# Shown in the greeting and letter. Safe to expose to the browser.
NEXT_PUBLIC_GIRLFRIEND_NAME=Mamon

# Where system-mail notes should go (used by mailto, safe to expose).
NEXT_PUBLIC_NOTIFICATION_EMAIL=tarakeswarjana0808@gmail.com

# Optional SMTP (only if you later want silent email without opening the mail app)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tarakeswarjana0808@gmail.com
# SMTP_PASS=
# NOTIFICATION_EMAIL=tarakeswarjana0808@gmail.com

